# Base de datos PostgreSQL (local via docker-compose)
DATABASE_URL=postgresql+psycopg://quadra:quadra@localhost:5432/quadra

# Seguridad / JWT
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS - origenes permitidos (frontend), separados por coma
CORS_ORIGINS=http://localhost:4200

# Entorno
ENVIRONMENT=development

# Demo: las demas empresas auto-aceptan las propuestas al materializarse.
# false en produccion: cada empresa responde con su propia sesion.
DEMO_AUTO_ACCEPT=true

# Credenciales del usuario admin creado por scripts.seed_base
ADMIN_EMAIL=admin@quadra.com
ADMIN_PASSWORD=admin1234
